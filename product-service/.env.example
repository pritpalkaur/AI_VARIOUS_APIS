# ---------------------------------------------------------------
# Product Service (Node.js / Express)
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------

PORT=5002
CORS_ORIGIN=http://localhost:5173

# SQL Server - SQL Server Authentication
DB_SERVER=localhost
DB_PORT=1433
# This service's own database (default ProductApiDb)
DB_NAME=ProductApiDb
DB_USER=user1
DB_PASSWORD=change_me
# true for a local SQL Server using its self-signed certificate
DB_TRUST_SERVER_CERT=true
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=15000

# Order Service - asked "does this product have orders?" before a delete
ORDER_SERVICE_URL=http://127.0.0.1:5003
SERVICE_CALL_TIMEOUT_MS=5000

# JWT - must be IDENTICAL to the values in auth-service/.env
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_ISSUER=auth-service
JWT_AUDIENCE=app-clients

# Logging: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
LOG_DIR=logs
