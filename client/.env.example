# ---------------------------------------------------------------
# Client (React + Vite) - URL only, NO secrets.
# Everything prefixed VITE_ is bundled into the browser code.
# Copy to .env (optional - this is also the built-in default).
# ---------------------------------------------------------------

# The client talks ONLY to the API gateway, which routes
# /api/auth -> Auth, /api/products -> Product, /api/orders -> Order.
VITE_API_GATEWAY_URL=http://localhost:5000
