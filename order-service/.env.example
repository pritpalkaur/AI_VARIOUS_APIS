# ---------------------------------------------------------------
# Order Service (Rust / Axum)
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------

PORT=5003
CORS_ORIGIN=http://localhost:5173

# SQL Server - SQL Server Authentication
DB_SERVER=localhost
DB_PORT=1433
# This service's own database (default OrderApiDb)
DB_NAME=OrderApiDb
DB_USER=user1
DB_PASSWORD=change_me
# true for a local SQL Server using its self-signed certificate
DB_TRUST_SERVER_CERT=true
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_SECONDS=15

# Product Service - looked up for price/name when an order is created or changes product
PRODUCT_SERVICE_URL=http://127.0.0.1:5002
SERVICE_CALL_TIMEOUT_MS=5000

# JWT - must be IDENTICAL to the values in auth-service/.env
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_ISSUER=auth-service
JWT_AUDIENCE=app-clients

# Logging: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
LOG_DIR=logs
