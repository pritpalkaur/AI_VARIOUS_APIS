# ---------------------------------------------------------------
# Auth Service (C# / ASP.NET Core)
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------

PORT=5001
CORS_ORIGIN=http://localhost:5173

# SQL Server - SQL Server Authentication
DB_SERVER=localhost
DB_PORT=1433
# This service's own database (default AuthDb)
DB_NAME=AuthDb
DB_USER=user1
DB_PASSWORD=change_me
# true for a local SQL Server using its self-signed certificate
DB_TRUST_SERVER_CERT=true
DB_POOL_MIN=0
DB_POOL_MAX=20
DB_CONNECT_TIMEOUT_SECONDS=15

# JWT - JWT_SECRET, JWT_ISSUER and JWT_AUDIENCE must be IDENTICAL
# in auth-service, product-service and order-service.
# JWT_SECRET: at least 32 characters of random text.
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_ISSUER=auth-service
JWT_AUDIENCE=app-clients
JWT_EXPIRES_MINUTES=60

# BCrypt cost (10-14). 12 is about 250 ms per hash.
BCRYPT_WORK_FACTOR=12

# Logging: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
LOG_DIR=logs
