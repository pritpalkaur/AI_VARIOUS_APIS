# ---------------------------------------------------------------
# SHARED settings for ALL services (auth, product, order, gateway).
# Copy this file to .env in the project root and fill in real values. Never commit .env.
#
# Each service reads its own <service>/.env first (optional, for overrides), then this
# shared file. Do NOT put PORT here - every service needs a different one, and each
# already defaults to the right port (gateway 5000, auth 5001, product 5002, order 5003).
# ---------------------------------------------------------------

# SQL Server - SQL Server Authentication (auth, product, order)
DB_SERVER=localhost
DB_PORT=1433
# No DB_NAME here: each service uses its own database (auth -> AuthDb, product -> ProductApiDb,
# order -> OrderApiDb). Override one in <service>/.env if needed.
DB_USER=user1
DB_PASSWORD=change_me
# true for a local SQL Server using its self-signed certificate
DB_TRUST_SERVER_CERT=true

# JWT (all four) - at least 32 characters. Signed by auth-service, checked by the others.
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_ISSUER=auth-service
JWT_AUDIENCE=app-clients
JWT_EXPIRES_MINUTES=60

# Browser client origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Service addresses: used by the gateway, and by services calling each other
# (order -> product for price/name, product -> order for the "has orders?" check).
# 127.0.0.1, not localhost: avoids a ~2 s IPv6 retry on Windows.
AUTH_SERVICE_URL=http://127.0.0.1:5001
PRODUCT_SERVICE_URL=http://127.0.0.1:5002
ORDER_SERVICE_URL=http://127.0.0.1:5003

# Logging (each service writes to its own <service>/logs folder)
LOG_LEVEL=info
