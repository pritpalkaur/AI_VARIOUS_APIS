# ---------------------------------------------------------------
# API Gateway (C# / ASP.NET Core + YARP)
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------

PORT=5000
# The browser client's origin - the only origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Where the gateway forwards requests. Use 127.0.0.1 rather than localhost: on Windows,
# localhost tries IPv6 (::1) first and each refused attempt costs about 2 seconds.
AUTH_SERVICE_URL=http://127.0.0.1:5001
PRODUCT_SERVICE_URL=http://127.0.0.1:5002
ORDER_SERVICE_URL=http://127.0.0.1:5003
# Max seconds to wait for a service before answering 504
PROXY_TIMEOUT_SECONDS=30

# JWT - must be IDENTICAL to the values in auth-service/.env
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_ISSUER=auth-service
JWT_AUDIENCE=app-clients

# Logging: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
LOG_DIR=logs
